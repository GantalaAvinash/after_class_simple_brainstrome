# Copy to .env and enter credentials there. Never commit .env.
MONGODB_URI=
# Optional: an Atlas URI whose database user can create/drop isolated test databases.
MONGODB_TEST_URI=
MONGODB_TEST_DATABASE=afterclass_test
DATABASE_NAME=afterclass
PORT=3000
# Origins have no trailing slash or repository path. Separate with commas.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Run npm run admin:setup to generate a private local password and salted hash.
# For Render, set these through its environment settings. No public default.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
