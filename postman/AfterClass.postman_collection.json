{
  "info": {
    "name": "AfterClass CST3144",
    "description": "Import into Postman. Set baseUrl to the real service. Practise mutations against test data. Run New order before Confirm order. For administration, set adminUsername/adminPassword as private local environment variables, then run Admin sign-in. Never export populated passwords/tokens. The administration folder creates a new test lesson, edits it, deletes/restores it and signs out.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "lessonId",
      "value": "100000000000000000000001"
    },
    {
      "key": "teacherId",
      "value": "200000000000000000000001"
    },
