                ]
              }
            }
          ]
        },
        {
          "name": "Lessons taught by Mina Patel",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/lessons?teacherId={{teacherId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Combined teacher and search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/lessons?teacherId={{teacherId}}&q=math"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Enrolment — confirmed purchased quantities",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/enrolment/{{lessonId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Nonnegative enrolment\", () => pm.expect(pm.response.json().enrolment).to.be.at.least(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Manual attribute update — changes persistent stock",
      "item": [
        {
          "name": "Set absolute spaces to 5 and price to 9",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/lessons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"updates\": [\n    {\n      \"lessonId\": \"{{lessonId}}\",\n      \"changes\": {\n        \"space\": 5,\n        \"price\": 9\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
