                ]
              }
            }
          ]
        },
        {
          "name": "Malformed lesson ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/enrolment/bad-id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid name",
          "request": {
            "method": "POST",
            "header": [
              {
