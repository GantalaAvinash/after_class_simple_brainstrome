              }
            ],
            "url": "{{baseUrl}}/lessons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"updates\": [\n    {\n      \"lessonId\": \"{{lessonId}}\",\n      \"changes\": {\n        \"_id\": \"forbidden\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
