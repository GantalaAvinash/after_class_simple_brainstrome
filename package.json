{
  "name": "afterclass-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CST3144 AfterClass API — staged coursework implementation",
  "engines": { "node": "24.x" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "check:atlas": "node --env-file-if-exists=.env scripts/check-atlas.js",
    "test": "node --test test/*.test.js",
    "test:atlas": "node --env-file-if-exists=.env --test test/atlas.test.js",
    "preview:test": "node support/preview.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongodb": "7.7.0"
  }
}
