{
  "name": "afterclass-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CST3144 AfterClass API — staged coursework implementation",
  "engines": { "node": "24.x" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:details": "node --env-file-if-exists=.env scripts/seed-details.js",
    "check:atlas": "node --env-file-if-exists=.env scripts/check-atlas.js",
    "test": "node --test test/*.test.js",
    "test:atlas": "node --env-file-if-exists=.env scripts/run-atlas-tests.js",
    "check:deployment": "node scripts/check-deployment.js",
    "preview:test": "node --env-file-if-exists=.env support/preview.js",
    "admin:setup": "node scripts/setup-admin.js",
    "postman": "node scripts/generate-postman.js",
    "export:atlas": "node --env-file-if-exists=.env scripts/export-atlas.js",
    "package:submission": "python3 scripts/package-submission.py"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongodb": "7.7.0"
  }
}
